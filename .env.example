# --- Postgres connection (Sanitrace) ---
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=your_postgres_password
PGDATABASE=sanitrace

# Database used by the integration tests. Created and dropped automatically;
# never point this at the same value as PGDATABASE.
TEST_PGDATABASE=sanitrace_test

# --- API ---
PORT=4000
WEB_ORIGIN=http://localhost:5173
